# Nusxa oling: cp .env.example .env  (.env git'ga tushmaydi)

# Mock qo'ng'iroq simulyatsiyasi (callSimulator.ts)
VITE_MOCK_CALLS=true

# Gemini ovozli yordamchi (ixtiyoriy). Bo'sh bo'lsa — brauzer ovozi va lokal javob ishlaydi.
# Diqqat: VITE_ o'zgaruvchilari brauzer bundle'iga tushadi.
VITE_GEMINI_API_KEY=
